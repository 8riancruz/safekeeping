# Settings for the wallet risk web app. Edit the values, then run: bash run_app.sh
# (This file stays on the server. Never commit it to GitHub.)

# your bucket name
BUCKET=sagemaker-notebook-469627110704

# region your EC2 instance and Bedrock are in
AWS_REGION=us-east-1

# blockchain.com free API key (leave blank if you don't have one)
BLOCKCHAIN_API_CODE=

# seconds between blockchain.com calls (free tier: keep at 10)
BLOCKCHAIN_MIN_INTERVAL=10

# most recent transactions to analyze per wallet
MAX_TXS=200

# Bedrock model ID for the AI summary (copy from Bedrock console). Blank = rule-based summary only.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
